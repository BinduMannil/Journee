# Journee environment template.
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# All values are read through src/lib/config — nothing here is hardcoded in app code.

# --- Supabase (data platform; see docs/decisions/ADR-002) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site / SEO ---
# Canonical public URL, used for metadata, robots, and sitemap. Defaults to
# http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# --- AI planning (LLM provider; server-only) ---
# When LLM_API_KEY is set AND "ai-planning" is in JOURNEE_ENABLED_FEATURES, the
# /api/plan/ai endpoint generates trips via the LLM; otherwise it returns 503 and
# the deterministic planner is used. Recommended: an Anthropic (Claude) key.
LLM_API_KEY=
# Optional model override; defaults to a Claude Sonnet model when only a key is set.
LLM_MODEL=

# --- Feature flags / config source (see docs/architecture/configuration-architecture.md) ---
# Comma-separated flags enabled at runtime. Examples:
#   supabase-destinations,affiliate-catalog   (turn on the DB-backed catalog + affiliate)
#   ai-planning                               (turn on LLM trip planning; needs LLM_API_KEY)
JOURNEE_ENABLED_FEATURES=

# --- Admin control plane (see docs/architecture/control-plane-architecture.md) ---
# When unset, /api/admin/* is disabled (503). When set, requests must send a
# matching `x-admin-token` header. Use a strong random value; keep it secret.
JOURNEE_ADMIN_TOKEN=
