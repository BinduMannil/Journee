# Journee environment template.
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# All values are read through src/lib/config — nothing here is hardcoded in app code.

# --- Supabase (data platform; see docs/decisions/ADR-002) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site / SEO ---
# Canonical public URL, used for metadata, robots, and sitemap. Defaults to
# http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# --- Feature flags / config source (see docs/architecture/configuration-architecture.md) ---
# Comma-separated flags enabled at runtime, e.g. "supabase-destinations,affiliate-catalog".
JOURNEE_ENABLED_FEATURES=
